//to check if the year is leap year

#include <iostream>
using namespace std;
int main(){
    int a;

    cout<<"Enter Year: ";
    cin>>a;

    if(a%4==0 && a%100!=0){                              
        cout<<"Leap Year"<<endl;
    }else{
        cout<<"Not Leap Year"<<endl;
    }

    return 0;
}
