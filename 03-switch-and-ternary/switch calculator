//to make calculator using switch

#include <iostream>
using namespace std;
int main(){
    float a,b;
    char op;

    cout<<"Enter number1: ";
    cin>>a;
    cout<<"Enter number2: ";
    cin>>b;
    cout<<"Enter the operator(+,-,/,*): ";
    cin>>op;

    switch(op){

        case '+':
        cout<<"Sum= "<<a+b<<endl;
        break;

        case '-':
        cout<<"Difference= "<<a-b<<endl;
        break;

        case '*':
        cout<<"Multiplication= "<<a*b<<endl;
        break;

        case '/':
        if(b!=0){
            cout<<"Division= "<<a/b<<endl;
        }else{
            cout<<"0 cant be denominator."<<endl;
        }
        break;

        default:
        cout<<"Enter valid Operator!"<<endl;

    }
    return 0;

}
